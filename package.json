{
  "name": "metalayer",
  "version": "1.0.1",
  "description": "Typesafe generators and validators for robots.txt, sitemap.xml and the Web App Manifest",
  "keywords": [
    "metadata",
    "robots.txt",
    "webmanifest",
    "manifest",
    "sitemap",
    "seo",
    "pwa",
    "typescript"
  ],
  "homepage": "https://github.com/dldvxyz/metalayer#readme",
  "bugs": {
    "url": "https://github.com/dldvxyz/metalayer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dldvxyz/metalayer.git"
  },
  "license": "MIT",
  "author": "dldv",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && node scripts/check-dist.mjs",
    "dev": "tsdown --watch",
    "format": "biome format --write",
    "generate": "bun run scripts/generate.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepublishOnly": "bun run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.6",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20"
  }
}
