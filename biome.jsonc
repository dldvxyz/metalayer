{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        // Member and key order is deliberate: option types follow the order of
        // the specs they model, and test fixtures read top-down.
        "useSortedKeys": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "performance": {
        // The package entry point is intentionally a barrel of the public API.
        "noBarrelFile": "off"
      },
      "style": {
        "useTemplate": "off",
        "useBlockStatements": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
